# Application database URL (Compose overrides this to use db:5432).
# For local non-Compose runs, use the database host and port exposed by your setup.
DATABASE_URL=postgresql+psycopg://invoiceuser:change-me@localhost:5433/invoices

# Gemini API key; get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model name; use a model available to your API key.
LLM_MODEL=gemini-2.5-flash
# Extraction provider; currently supported value is gemini.
LLM_PROVIDER=gemini
# Directory where uploaded invoice files are stored.
STORAGE_DIR=/app/storage
# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# PostgreSQL credentials used by docker-compose.yml; replace these locally.
POSTGRES_USER=invoiceuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoices
